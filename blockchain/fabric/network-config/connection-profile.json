{
  "name": "meditrace-network",
  "version": "1.0.0",
  "client": {
    "organization": "ManufacturerOrg",
    "connection": {
      "timeout": {
        "peer": {
          "endorser": "300"
        },
        "orderer": "300"
      }
    }
  },
  "channels": {
    "meditracechannel": {
      "orderers": ["orderer.meditrace.internal"],
      "peers": {
        "peer0.manufacturer.meditrace.internal": {
          "endorsingPeer": true,
          "chaincodeQuery": true,
          "ledgerQuery": true,
          "eventSource": true
        },
        "peer0.distributor.meditrace.internal": {
          "endorsingPeer": true,
          "chaincodeQuery": true,
          "ledgerQuery": true,
          "eventSource": true
        },
        "peer0.warehouse.meditrace.internal": {
          "endorsingPeer": true,
          "chaincodeQuery": true,
          "ledgerQuery": true,
          "eventSource": true
        },
        "peer0.pharmacy.meditrace.internal": {
          "endorsingPeer": true,
          "chaincodeQuery": true,
          "ledgerQuery": true,
          "eventSource": true
        }
      }
    }
  },
  "organizations": {
    "ManufacturerOrg": {
      "mspid": "ManufacturerMSP",
      "peers": ["peer0.manufacturer.meditrace.internal"],
      "cryptoPath": "organizations/peerOrganizations/manufacturer.meditrace.internal/users/Admin@manufacturer.meditrace.internal/msp"
    },
    "DistributorOrg": {
      "mspid": "DistributorMSP",
      "peers": ["peer0.distributor.meditrace.internal"],
      "cryptoPath": "organizations/peerOrganizations/distributor.meditrace.internal/users/Admin@distributor.meditrace.internal/msp"
    },
    "WarehouseOrg": {
