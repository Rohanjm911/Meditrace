      "cryptoPath": "organizations/peerOrganizations/warehouse.meditrace.internal/users/Admin@warehouse.meditrace.internal/msp"
    },
    "PharmacyOrg": {
      "mspid": "PharmacyMSP",
      "peers": ["peer0.pharmacy.meditrace.internal"],
      "cryptoPath": "organizations/peerOrganizations/pharmacy.meditrace.internal/users/Admin@pharmacy.meditrace.internal/msp"
    }
  },
  "orderers": {
    "orderer.meditrace.internal": {
      "url": "grpcs://localhost:7050",
      "grpcOptions": {
        "ssl-target-name-override": "orderer.meditrace.internal"
      }
    }
  },
  "peers": {
    "peer0.manufacturer.meditrace.internal": {
