# MediTrace Environment Configuration (Windows Native - Non-Docker)

# Application Port
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000

# PostgreSQL Connection
# If port 5432 has custom password, the automated setup helper creates a local cluster on port 5433
DATABASE_URL="postgresql://postgres@localhost:5433/meditrace"

# JWT Secret for Session Authentication
JWT_SECRET="meditrace-secure-production-ready-jwt-secret-key-32chars"
JWT_EXPIRES_IN="8h"

# Hyperledger Fabric Gateway Configuration
# Mode: "FABRIC_LIVE" (connects to live Fabric Gateway) or "DEMO_INTEGRITY" (non-Docker cryptographic ledger)
FABRIC_MODE="DEMO_INTEGRITY"
FABRIC_GATEWAY_ENDPOINT="localhost:7051"
FABRIC_CHANNEL_NAME="meditracechannel"
FABRIC_CHAINCODE_NAME="meditrace-cc"
FABRIC_MSP_ID="ManufacturerMSP"
FABRIC_CRYPTO_PATH="./blockchain/fabric/network-config/crypto-material"

# IoT Simulator Configuration
IOT_SIMULATOR_PORT=4001
IOT_SIMULATOR_INTERVAL_MS=5000
IOT_SIMULATION_MODE="NORMAL" # Options: NORMAL, EXCURSION, DISCONNECTED

# CORS Allowed Origins
CORS_ORIGIN="http://localhost:5173,http://localhost:4000,file://"
